<?xml version="1.0" encoding="UTF-8"?>
<!-- Weekly sync audit: checks every repo (monorepo, nested, external) for
     work that exists only on this machine — dirty files, unpushed commits,
     repos with no GitHub remote. Writes ~/Experiments/sync-report.json.
     Runs Monday 9:00am. Read the log or the report; the job is silent
     otherwise. Install:
       launchctl load -w ~/Library/LaunchAgents/com.josh.sync-audit.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.josh.sync-audit</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/joshgreenman/Experiments/scripts/sync-audit.py</string>
    <string>--fetch</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/joshgreenman/Experiments</string>
  <key>StandardOutPath</key>
  <string>/Users/joshgreenman/Library/Logs/sync-audit.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/joshgreenman/Library/Logs/sync-audit.err</string>
</dict>
</plist>
