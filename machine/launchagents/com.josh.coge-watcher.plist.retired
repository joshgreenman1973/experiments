<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.josh.coge-watcher</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/joshgreenman/Experiments/nyc-coge-testimony/scripts/check_new_hearings.py</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/joshgreenman/Experiments/nyc-coge-testimony/scripts/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/joshgreenman/Experiments/nyc-coge-testimony/scripts/launchd.err.log</string>
</dict>
</plist>
