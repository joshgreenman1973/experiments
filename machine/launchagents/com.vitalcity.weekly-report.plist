<?xml version="1.0" encoding="UTF-8"?>
<!-- Vital City weekly growth report. Writes a Markdown summary of the last 7
     days to the Desktop every Thursday at 12:00 local time.
     Install:
       launchctl load -w ~/Library/LaunchAgents/com.vitalcity.weekly-report.plist
     The script reads the dashboard passphrase from the macOS Keychain item
     'vc-network-pass' (add once with `security add-generic-password ...`). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vitalcity.weekly-report</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/joshgreenman/Experiments/vital-city-catalogue/weekly_report.py</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>4</integer>
    <key>Hour</key><integer>12</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/joshgreenman/Experiments/vital-city-catalogue</string>
  <key>StandardOutPath</key>
  <string>/Users/joshgreenman/Library/Logs/vital-city-weekly.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/joshgreenman/Library/Logs/vital-city-weekly.err</string>
</dict>
</plist>
