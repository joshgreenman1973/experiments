<?xml version="1.0" encoding="UTF-8"?>
<!-- NYC child density: annual ACS refresh. scripts/annual_refresh.sh
     auto-detects whether a newer ACS 5-year endyear has been published,
     rebuilds docs/*.json if so, and pushes. Needs a CENSUS_API_KEY in the
     login keychain (security add-generic-password -s CENSUS_API_KEY -a
     joshgreenman -w "<key>"). Runs Dec 15 at 08:00 local time — the Census
     Bureau typically releases the next ACS5 endyear in December — plus a
     January 15 backup run in case the release lands late.
     Install / activate:
       launchctl load -w ~/Library/LaunchAgents/com.joshgreenman.child-density-refresh.plist
     Run once now:
       launchctl start com.joshgreenman.child-density-refresh -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.joshgreenman.child-density-refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/joshgreenman/Experiments/nyc-child-density/scripts/annual_refresh.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Month</key><integer>12</integer>
      <key>Day</key><integer>15</integer>
      <key>Hour</key><integer>8</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Month</key><integer>1</integer>
      <key>Day</key><integer>15</integer>
      <key>Hour</key><integer>8</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/joshgreenman/Experiments/nyc-child-density</string>
  <key>StandardOutPath</key>
  <string>/Users/joshgreenman/Experiments/nyc-child-density/annual_refresh.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/joshgreenman/Experiments/nyc-child-density/annual_refresh.log</string>
</dict>
</plist>
