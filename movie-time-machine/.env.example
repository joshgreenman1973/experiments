# Optional. The app reads its TMDB proxy URL from src/config.js, which is
# committed because the URL is public and harmless. Set this only to point a
# local dev session at a different Worker.
#
# There is deliberately no API key setting: the key lives in the Cloudflare
# Worker (see ./worker) as an encrypted secret. Anything set here would be
# compiled into the published JavaScript for anyone to read.
# VITE_TMDB_PROXY=https://good-time-tmdb.example.workers.dev
