# Preferred: URL of the Cloudflare Worker in ./worker (no trailing slash).
# When this is set, no API key is compiled into the published site.
VITE_TMDB_PROXY=https://good-time-tmdb.YOUR-SUBDOMAIN.workers.dev

# Fallback for local development only. Anything set here is baked into the
# built JavaScript, so never use this for a build you publish.
VITE_TMDB_API_KEY=your_tmdb_v3_key
