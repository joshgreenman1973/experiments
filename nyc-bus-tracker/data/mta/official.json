 "flags": [
  {
   "head": "Routes line up almost exactly",
   "text": "Rank the 338 routes both sources cover from slowest to fastest, and the two lists nearly match (rank correlation 0.99, where 1 is identical).",
   "detail": "For comparing routes with each other, the tracker and the MTA tell the same story."
  },
  {
   "head": "Local buses read faster here",
   "text": "On the typical local route the tracker reads 9% faster than the MTA. B41: 7.9 mph here, 6.7 MTA; M15+: 9.1 mph here, 7.9 MTA; BX19: 6.9 mph here, 5.7 MTA.",
   "detail": "Treat the tracker's speed as speed while moving. The biggest gaps are on slow, crowded routes, where buses spend the most time stopped."
  },
  {
   "head": "Staten Island express buses read slower here",
   "text": "The opposite happens on SIM express routes: the tracker reads them 11% slower. SIM22: 17.8 mph here, 23.3 MTA.",
   "detail": "Not yet explained. Candidates include positions that refresh less often on highway stretches. The borough chart keeps express routes in their own group for this reason."
  },
  {
   "head": "Small monthly moves are noise here",
   "text": "From July 2026 to August 2026 the tracker moved +0.1 mph and the MTA, averaged the same way, +0.1 mph.",
   "detail": "Changes of a few tenths are within the tracker's noise: which late-evening hours the collector caught shifts from month to month."
  },
  {
   "head": "The MTA's two ridership counts disagree",
   "text": "Over the last 12 months, the passenger-counter figure ran anywhere from 96% to 112% of the MTA's daily bus ridership count.",
   "detail": "So a month-to-month change in riders depends on which count you use. Say which one."
  }
 ],
