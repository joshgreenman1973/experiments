# Local Netlify folder
.netlify
node_modules/
.DS_Store

# Bus tracker: cached source files for scripts/build_geo_layers.py (re-fetched on demand)
nyc-bus-tracker/scripts/geo-cache/

# The policy calendar is its own repo (vitalcity-nyc/nyc-policy-calendar) and
# deploys from there. A stale April 2026 copy of index.html used to be tracked
# here, which made the gallery builder treat it as a parent-repo project and
# link the gallery card at the old static page instead of the live site.
nyc-policy-calendar/

# Machine-local sync audit output (machine/repos.json is the committed inventory)
sync-report.json

# Local-only working folders — never commit (public repo, ~1GB Pages limit)
personal/
_archive/
vital-city-tools/
vital-city-headshots/
nyc-capital-changelog/
sasha-dollhouse/audio-old-voices/

# Machine-local runtime state for the CI auto-repair loop
.ci-autorepair/

# Working clone of vitalcity-nyc/streetlightmeter — lives in its own repo
slm-wire/

# 18.8MB US Code metadata from GPO, cited by law-growth/methodology.html.
# Re-downloadable from govinfo.gov; not worth carrying in a public repo.
mods.xml

